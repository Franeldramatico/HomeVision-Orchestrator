# Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_NAME=HomeVisionDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=HomeVisionOrchestrator
JWT_AUDIENCE=HomeVisionClients
JWT_EXPIRATION_HOURS=24

# Samsung TV Configuration
SAMSUNG_TV_IP=192.168.1.100
SAMSUNG_TV_PORT=8002
SAMSUNG_TV_TOKEN=your-samsung-tv-token

# API Gateway
API_GATEWAY_PORT=5000
API_GATEWAY_URL=http://localhost:5000

# Services Ports
AUTH_SERVICE_PORT=5001
ORCHESTRATION_SERVICE_PORT=5002
TV_INTEGRATION_SERVICE_PORT=3000

# WebSocket Configuration
WS_PORT=8080

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=Information

# Redis (for caching - optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
